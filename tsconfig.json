{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "react"
    ],
    "lib": [
      "ES2024",
      "DOM"
    ]
  },
  "include": [
    "src/client/**/*",
    "src/**/*.d.ts",
    "tsdown.config.ts"
  ]
}
